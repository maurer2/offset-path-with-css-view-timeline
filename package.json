{
  "name": "offset-path-with-css-view-timeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ],
    "#components/*": [
      "./src/components/*",
      "./src/components/*.ts",
      "./src/components/*.tsx"
    ],
    "#assets/*": "./src/assets/*"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7",
    "@vitejs/plugin-react": "^6.1.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "npm:@typescript/typescript6@~6",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "packageManager": "pnpm@11.21.0"
}
